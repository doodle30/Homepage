---
import { getSite, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const site = getSite(Astro.props.locale);
const { contact } = site;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <p class="name">{site.name}</p>
    <ul>
      {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
      {contact.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
    </ul>
    <p class="copy">© {year} Mowgli Games</p>
  </div>
</footer>
<style>
  .footer { background: var(--bi-surface-alt); color: var(--bi-text-muted); padding-block: 2.5rem; font-size: 0.9rem; }
  .name { color: var(--bi-text); font-weight: 700; }
  ul { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  a { color: inherit; }
</style>
