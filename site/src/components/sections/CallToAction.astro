---
import { url, type Locale } from '../../lib/i18n';
interface Props { locale: Locale; title: string; button: { label: string; href: string } }
const { locale, title, button } = Astro.props;
---
<section class="cta section">
  <div class="container inner">
    <h2>{title}</h2>
    <a class="btn" href={url(button.href, locale)}>{button.label}</a>
  </div>
</section>
<style>
  .cta { background: var(--bi-primary); color: var(--bi-on-primary); }
  .inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  h2 { margin: 0; }
  .btn { background: var(--bi-on-primary); color: var(--bi-primary); }
</style>
