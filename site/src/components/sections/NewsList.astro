---
import type { CollectionEntry } from 'astro:content';
import { getSite, url, type Locale } from '../../lib/i18n';
import { slugOf } from '../../lib/news';
interface Props { locale: Locale; title?: string; posts: CollectionEntry<'news'>[]; headingLevel?: 'h1' | 'h2' }
const { locale, posts, headingLevel = 'h2' } = Astro.props;
const site = getSite(locale);
const title = Astro.props.title ?? site.ui.news;
const H = headingLevel;
const fmt = (d: Date) => d.toLocaleDateString(site.ui.dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
---
<section class="section">
  <div class="container">
    <H>{title}</H>
    {posts.length === 0 ? <p>{site.ui.noNews}</p> : (
      <ul>
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
            <a href={url(`/news/${slugOf(p)}`, locale)}>{p.data.title}</a>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
<style>
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { border-top: 1px solid var(--bi-border); padding-block: 1.25rem; }
  time { display: block; color: var(--bi-text-muted); font-size: 0.875rem; }
  a { font-weight: 600; font-size: 1.1rem; }
  p { color: var(--bi-text-muted); margin: 0.25rem 0 0; }
</style>
