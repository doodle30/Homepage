---
import type { CollectionEntry } from 'astro:content';
interface Props { title?: string; posts: CollectionEntry<'news'>[]; headingLevel?: 'h1' | 'h2' }
const { title = 'News', posts, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<section class="section">
  <div class="container">
    <H>{title}</H>
    {posts.length === 0 ? <p>No news yet.</p> : (
      <ul>
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
            <a href={`/news/${p.id}`}>{p.data.title}</a>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
<style>
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { border-top: 1px solid var(--bi-border); padding-block: 1.25rem; }
  time { display: block; color: var(--bi-text-muted); font-size: 0.875rem; }
  a { font-weight: 600; font-size: 1.1rem; }
  p { color: var(--bi-text-muted); margin: 0.25rem 0 0; }
</style>
