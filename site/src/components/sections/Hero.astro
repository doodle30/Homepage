---
import { url, type Locale } from '../../lib/i18n';
interface Props { locale: Locale; title: string; body: string; cta?: { label: string; href: string } }
const { locale, title, body, cta } = Astro.props;
---
<section class="hero section">
  <div class="container">
    <h1>{title}</h1>
    <p class="lead">{body}</p>
    {cta && <a class="btn" href={url(cta.href, locale)}>{cta.label}</a>}
  </div>
</section>
<style>
  .hero { background: var(--bi-surface); }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); max-width: 18em; }
  .lead { font-size: 1.15rem; color: var(--bi-text-muted); max-width: 36em; margin-bottom: 2rem; }
</style>
