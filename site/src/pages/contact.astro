---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const { contact } = site;
---
<Base title="Contact">
  <section class="section">
    <div class="container">
      <h1>Contact</h1>
      <dl>
        {contact.email && <><dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></>}
        {contact.links.map((l) => <><dt>{l.label}</dt><dd><a href={l.href} rel="noopener">{l.href.replace(/^https?:\/\//, '')}</a></dd></>)}
      </dl>
    </div>
  </section>
</Base>
<style>
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.75rem 2rem; margin-top: 2rem; }
  dt { color: var(--bi-text-muted); }
  dd { margin: 0; }
</style>
