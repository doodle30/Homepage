---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Games from '../components/sections/Games.astro';
import NewsList from '../components/sections/NewsList.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import site from '../data/site.json';

const posts = (await getCollection('news', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <Hero {...site.hero} />
  <Games {...site.games} />
  <NewsList title="Latest news" posts={posts} />
  <CallToAction {...site.cta} />
</Base>
