---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Games from '../components/sections/Games.astro';
import NewsList from '../components/sections/NewsList.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import { getSite, type Locale } from '../lib/i18n';
import { getPosts } from '../lib/news';

interface Props { locale: Locale }
const { locale } = Astro.props;
const site = getSite(locale);
const posts = (await getPosts(locale)).slice(0, 3);
---
<Base locale={locale}>
  <Hero locale={locale} {...site.hero} />
  <Games locale={locale} {...site.games} />
  <NewsList locale={locale} title={site.ui.latestNews} posts={posts} />
  <CallToAction locale={locale} {...site.cta} />
</Base>
