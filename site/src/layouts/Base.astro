---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, url, asset, routeOf, locales, type Locale } from '../lib/i18n';

interface Props { locale?: Locale; title?: string; description?: string; routes?: Partial<Record<Locale, string>> }
// routes: 언어별 이동 경로를 직접 줄 때 (예: 번역이 없는 글은 그 언어의 소식 목록). 주면 hreflang 대체 링크는 생략.
const { locale = 'en', title, description, routes } = Astro.props;
const noAlternates = !!routes;
const site = getSite(locale);
const desc = description ?? site.description;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const route = routeOf(Astro.url.pathname);
const langRoutes = Object.fromEntries(locales.map((l) => [l, routes?.[l] ?? route])) as Record<Locale, string>;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const ogImage = abs(asset('/og.png'));
---
<!doctype html>
<html lang={site.lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2a1d17" /> {/* check-site-ignore: theme-color needs a literal; = Cocoa, brand/brand.md */}
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(url(route, locale))} />
    {!noAlternates && locales.map((l) => <link rel="alternate" hreflang={l} href={abs(url(route, l))} />)}
    {!noAlternates && <link rel="alternate" hreflang="x-default" href={abs(url(route, 'en'))} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=IBM+Plex+Sans+KR:wght@400;600&display=swap" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.ui.skip}</a>
    <Header locale={locale} route={route} langRoutes={langRoutes} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
